# Copy to .env for local dev: cp .env.example .env
# Values below are the same defaults docker-compose.yml falls back to
# when a var is unset, kept here explicit so they're easy to change.

# --- Postgres (simulated_app) ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=simulated_app
POSTGRES_PORT=5432

# --- MinIO (Landing) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ClickHouse (Bronze/Silver/Gold) ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=bronze
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9004
